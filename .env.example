# ── Required API keys ───────────────────────────────────────────────────────
# YouTube Data API v3 key
# Get one free at: https://console.cloud.google.com/apis/credentials
# (Enable "YouTube Data API v3" for your project first)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API key — free tier, no credit card needed
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Zerops Valkey cache (optional for local dev, set on Zerops dashboard) ───
# Add a Valkey service to your Zerops project, then set these.
# If unset, the app runs without caching (fully functional, just slower).
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ── Local dev only ──────────────────────────────────────────────────────────
FLASK_DEBUG=false
PORT=8000
